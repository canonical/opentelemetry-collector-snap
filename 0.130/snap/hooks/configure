#!/bin/sh

get_feature_gates() {
  value="$(snapctl get feature-gates)"
  if [ -n "$value" ]; then
    set_feature_gates "$value"
  fi
  echo "$value"
}

set_feature_gates() {
  snapctl set feature-gates="$1"
}

is_valid_proxy_url() {
    url="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    # scheme://[user[:pass]@]host[:port][/], where host is a hostname, an IPv4
    # address or a bracketed IPv6 address
    printf '%s\n' "$url" | grep -qE '^(https?|socks5h?)://([^/]*@)?([a-z0-9.-]+|\[[0-9a-f:.]+\])(:[0-9]{1,5})?/?$' || return 1
    port="$(printf '%s\n' "$url" | sed -nE 's#^[a-z0-9]+://([^/]*@)?([a-z0-9.-]+|\[[0-9a-f:.]+\]):([0-9]+)/?$#\3#p')"
    [ -z "$port" ] || { [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; }
}

handle_feature_gates() {
    feature_gates="$(get_feature_gates)"
    if [ -n "$feature_gates" ]; then
        # Validate
        otelcol validate --feature-gates="$feature_gates" 2>&1 | grep --ignore-case --quiet "no such feature gate"
        return_code=$?
        # return code 0 means grep found a matching string
        if [ $return_code -eq 0 ] ; then
            echo "\"$feature_gates\" is not a valid feature gate definition" >&2
            return 1
        fi
    fi
    set_feature_gates "$feature_gates"
}

handle_proxy() {
    for option in http-proxy https-proxy; do
        value="$(snapctl get "$option")"
        if [ -n "$value" ] && ! is_valid_proxy_url "$value"; then
            # snapd discards the configuration change when this hook fails, so the
            # previously configured value is left in place
            echo "\"$value\" is not a valid proxy URL for \"$option\": expected scheme://[user[:pass]@]host[:port][/], with an http://, https://, socks5:// or socks5h:// scheme" >&2
            return 1
        fi
    done
}

handle_feature_gates && handle_proxy && snapctl restart opentelemetry-collector.opentelemetry-collector
