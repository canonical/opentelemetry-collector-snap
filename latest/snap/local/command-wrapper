#!/bin/sh

log() {
  echo "$1" | systemd-cat
}

redact() {
  # Hide credentials embedded in a proxy URL before logging it
  printf '%s\n' "$1" | sed -E 's#(://)[^/]*@#\1***@#'
}

setup_proxy() {
  # Export the proxy settings from the snap configuration, in both upper and lower
  # case, as the collector's HTTP clients honor either form.
  HTTPS_PROXY_VALUE="$(snapctl get https-proxy)"
  if [ -n "$HTTPS_PROXY_VALUE" ]; then
    log "setting HTTPS_PROXY to $(redact "$HTTPS_PROXY_VALUE")"
    export HTTPS_PROXY="$HTTPS_PROXY_VALUE"
    export https_proxy="$HTTPS_PROXY_VALUE"
  fi

  HTTP_PROXY_VALUE="$(snapctl get http-proxy)"
  if [ -n "$HTTP_PROXY_VALUE" ]; then
    log "setting HTTP_PROXY to $(redact "$HTTP_PROXY_VALUE")"
    export HTTP_PROXY="$HTTP_PROXY_VALUE"
    export http_proxy="$HTTP_PROXY_VALUE"
  fi

  NO_PROXY_VALUE="$(snapctl get no-proxy)"
  if [ -n "$NO_PROXY_VALUE" ]; then
    log "setting NO_PROXY to $NO_PROXY_VALUE"
    export NO_PROXY="$NO_PROXY_VALUE"
    export no_proxy="$NO_PROXY_VALUE"
  fi
}

launch_strict() {
  DEFAULT_CONFIG_FILE="$SNAP/etc/config.yaml"
  CONFIG_FOLDER="/etc/otelcol/config.d"

  # we parse/enable the feature gates regardless of which config we're loading
  FEATURE_GATES_VALUE="$(snapctl get feature-gates)"
  if [ -z "$FEATURE_GATES_VALUE" ]
  then
    log "no feature gates configured"
    FEATURE_GATES_ARG=""
  else
    log "enabling feature gates: $FEATURE_GATES_VALUE"
    FEATURE_GATES_ARG="--feature-gates=${FEATURE_GATES_VALUE}"
  fi
  # export the proxy settings regardless of which config we're loading
  setup_proxy
  
  # If the snap can access $CONFIG_FOLDER and there is at least one file inside
  if snapctl is-connected etc-otelcol-config; then
    CONFIG_FILES="$(find $CONFIG_FOLDER -type f -size +0c -print)"
    if [ -n "$CONFIG_FILES" ]; then
        log "Launching with config files: $CONFIG_FILES"
        CONFIG_ARG=""
        for file in $CONFIG_FILES; do
            CONFIG_ARG="${CONFIG_ARG} --config ${file}"
        done
        
         # shellcheck disable=SC2086 # we need to unpack $CONFIG_ARG because it contains spaces 
        exec "$SNAP/bin/otelcol" $CONFIG_ARG "$FEATURE_GATES_ARG"
    fi
  fi

  log "Launching with minimal default config from the snap"
  exec "$SNAP/bin/otelcol" "--config" "$DEFAULT_CONFIG_FILE" "$FEATURE_GATES_ARG"
}

launch_strict
